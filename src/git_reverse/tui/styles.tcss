/*
 * Git Reverse — Minimal Terminal Design System (TDS)
 *
 * Inspired by: Obsidian, Warp, Linear
 * Grayscale Slate canvas with a single Blue Accent. No decorative borders.
 */

/* ─── Design Tokens ─────────────────────────────────────── */

$background:        #080c15;   /* Deep charcoal slate main canvas */
$surface:           #0e1422;   /* Slightly elevated panel surface */
$surface-alt:       #121b2d;   /* Modal / popup alternate surface */
$border:            #1a2438;   /* Subtle divider lines */
$border-focus:      #3b82f6;   /* Active accent blue focus */

$text:              #f1f5f9;   /* Crisp slate white read text */
$text-muted:        #64748b;   /* Muted captions/labels */
$text-dim:          #475569;   /* Inactive / placeholder text */

$accent:            #3b82f6;   /* Accent blue */
$accent-dim:        #1e293b;   /* Low-contrast accent fill */

$success:           #10b981;   /* Pipeline completed / green */
$warning:           #f59e0b;   /* Warnings */
$error:             #ef4444;   /* Failures / errors */

/* ─── Screen Foundation ─────────────────────────────────── */

Screen {
    background: $background;
    color: $text;
}

Header {
    background: $surface;
    color: $text-muted;
    text-style: bold;
    height: 1;
}

Footer {
    background: $surface;
    color: $text-dim;
    height: 1;
}

/* ─── Shell Layout ───────────────────────────────────────── */

#body {
    height: 1fr;
    layout: horizontal;
}

/* ─── Sidebar ────────────────────────────────────────────── */

#sidebar {
    width: 30;
    background: $surface;
    border-right: solid $border;
    padding: 1 2;
}

#sidebar.collapsed {
    display: none;
}

#sidebar-title {
    color: $accent;
    text-style: bold;
    margin-bottom: 2;
}

#session-list-title,
#file-tree-title {
    color: $text-muted;
    text-style: bold;
    margin-top: 1;
    margin-bottom: 1;
}

.session-item,
.file-item {
    color: $text;
    padding: 0 1;
}

/* ─── ListView Base ──────────────────────────────────────── */

ListView {
    background: transparent;
}

ListView > ListItem {
    padding: 0;
    margin-bottom: 1;
    background: transparent;
}

ListView > ListItem.--highlight {
    background: $accent-dim;
    color: $text;
    text-style: bold;
}

ListView > ListItem:hover {
    background: $border;
}

/* ─── Main Panel ─────────────────────────────────────────── */

MainPanel {
    width: 1fr;
    height: 1fr;
    background: $background;
}

/* ─── Home View ──────────────────────────────────────────── */

#welcome-content {
    align: center middle;
    width: 100%;
    height: 100%;
    background: $background;
    padding: 0 6;
}

#home-title {
    color: $text;
    text-style: bold;
    margin-bottom: 1;
    text-align: center;
}

#home-tagline {
    color: $text-muted;
    margin-bottom: 3;
    text-align: center;
}

#home-input-zone {
    width: 60;
    margin-bottom: 2;
}

#repo-input {
    border-bottom: solid $border;
    background: transparent;
    color: $text;
    padding: 0;
    width: 100%;
    height: 1;
}

#repo-input:focus {
    border-bottom: solid $border-focus;
}

#repo-input > .input--placeholder {
    color: $text-dim;
}

#home-recent-title {
    color: $text-muted;
    text-style: bold;
    margin-top: 2;
    margin-bottom: 1;
    text-align: center;
}

#home-recent-list {
    width: 60;
    height: 8;
    background: transparent;
}

#home-hint {
    color: $text-dim;
    margin-top: 2;
    text-align: center;
}

/* ─── Analysis / Ingestion View ──────────────────────────── */

#analysis-view {
    align: center middle;
    width: 100%;
    height: 100%;
    padding: 0 6;
    background: $background;
}

#analysis-repo-name {
    color: $text-muted;
    margin-bottom: 1;
    text-align: center;
}

#analysis-title {
    color: $text;
    text-style: bold;
    margin-bottom: 2;
    text-align: center;
}

#analysis-progress-bar {
    width: 50;
    height: 1;
    background: $border;
    color: $accent;
    margin-bottom: 2;
}

ProgressBar > .bar--bar {
    color: $accent;
}

ProgressBar > .bar--complete {
    color: $success;
}

#analysis-pipeline-stages {
    width: 50;
    margin-bottom: 2;
}

.stage-item {
    color: $text-muted;
    margin-bottom: 1;
}

.stage-item.complete {
    color: $success;
}

.stage-item.running {
    color: $accent;
    text-style: bold;
}

.stage-item.pending {
    color: $text-dim;
}

.stage-item.failed {
    color: $error;
}

#analysis-current-task {
    color: $text-muted;
    margin-bottom: 2;
    text-align: center;
}

#analysis-log-toggle-tip {
    color: $text-dim;
    text-align: center;
    margin-bottom: 1;
}

#analysis-log-container {
    width: 60;
    height: 8;
    background: $surface;
    padding: 1 1;
    display: none;
}

.log-item {
    color: $text-muted;
}

/* ─── Chat / Workspace ───────────────────────────────────── */

ChatPane {
    height: 1fr;
    padding: 0 1;
    background: $background;
}

#chat-workspace {
    height: 1fr;
    layout: horizontal;
}

#chat-main-area {
    width: 1fr;
    height: 1fr;
}

#chat-area {
    height: 1fr;
    padding: 1 0;
    background: transparent;
}

#chat-input-box {
    margin-top: 1;
    margin-bottom: 1;
    height: auto;
    border-top: solid $border;
    padding-top: 1;
}

#chat-mode-label {
    color: $text-dim;
    margin-bottom: 1;
}

#chat-input {
    border-bottom: solid $border;
    background: transparent;
    color: $text;
    padding: 0;
    height: 1;
    width: 100%;
}

#chat-input:focus {
    border-bottom: solid $border-focus;
}

/* ─── Message Bubbles ────────────────────────────────────── */

UserMessageWidget {
    background: transparent;
    padding: 1 0;
    margin-bottom: 1;
    border-bottom: solid $border;
    height: auto;
}

.user-label {
    color: $text-muted;
    text-style: bold;
    margin-bottom: 1;
}

AssistantMessageWidget {
    background: transparent;
    padding: 1 0;
    margin-bottom: 1;
    border-bottom: solid $border;
    height: auto;
}

.assistant-header {
    layout: horizontal;
    align: left middle;
    margin-bottom: 1;
    height: 1;
}

.assistant-label {
    color: $accent;
    text-style: bold;
    width: 1fr;
}

.copy-btn {
    min-width: 6;
    height: 1;
    border: none;
    background: transparent;
    color: $text-muted;
}

.copy-btn:hover {
    color: $accent;
    background: transparent;
}

/* ─── Thinking Panel ─────────────────────────────────────── */

#thinking-panel {
    background: transparent;
    padding: 1 0;
    margin-top: 1;
    height: auto;
}

#thinking-title {
    color: $text;
    text-style: bold;
    margin-bottom: 1;
}

#thinking-bar {
    color: $accent;
    margin-bottom: 1;
}

#thinking-status {
    color: $text-dim;
    text-style: italic;
}

/* ─── Evidence Panel ─────────────────────────────────────── */

#evidence-panel {
    width: 32;
    border-left: solid $border;
    background: $surface;
    padding: 1 2;
    height: 1fr;
}

#evidence-title {
    color: $text-muted;
    text-style: bold;
    margin-bottom: 2;
}

.evidence-item {
    color: $text-muted;
    margin-bottom: 1;
}

.evidence-header {
    color: $text;
    margin-bottom: 0;
}

.evidence-detail {
    color: $text-dim;
    margin-bottom: 1;
}

/* ─── Status Bar ─────────────────────────────────────────── */

#status-bar {
    height: 1;
    background: $surface;
    color: $text-muted;
    border-top: solid $border;
    padding: 0 2;
}

/* ─── Modals & Overlays ──────────────────────────────────── */

OnboardingScreen,
SettingsScreen {
    align: center middle;
    background: rgba(0, 0, 0, 0.4);
}

CommandPalette {
    align: center top;
    background: rgba(0, 0, 0, 0.4);
    padding-top: 3;
}

#onboarding-container,
#settings-container {
    background: $surface-alt;
    border: solid $border;
    padding: 2 4;
}

#onboarding-container {
    width: 60;
    height: auto;
}

#settings-container {
    width: 52;
    height: auto;
}

#onboarding-title,
#settings-title {
    color: $text;
    text-style: bold;
    margin-bottom: 2;
}

#onboarding-grid,
#settings-grid {
    grid-size: 2;
    grid-columns: 1fr 2fr;
    grid-gutter: 1;
    margin-bottom: 2;
}

#onboarding-grid Label,
#settings-grid Label {
    padding-top: 1;
    color: $text-muted;
}

#onboarding-grid Input,
#settings-grid Input {
    border-bottom: solid $border;
    background: transparent;
    padding: 0;
    height: 1;
}

#onboarding-grid Input:focus,
#settings-grid Input:focus {
    border-bottom: solid $border-focus;
}

#onboarding-status,
#settings-status {
    color: $success;
    margin-bottom: 2;
    text-style: bold;
}

#model-selection-box {
    height: 6;
    border: solid $border;
    background: $background;
    margin-bottom: 2;
}

#buttons-row {
    align: right middle;
    height: auto;
    margin-top: 1;
}

#buttons-row Button {
    margin-left: 2;
    border: none;
    background: transparent;
    color: $text;
}

#buttons-row Button:hover {
    color: $accent;
}

Button.primary {
    color: $accent;
    text-style: bold;
}

Button.primary:hover {
    color: $text;
}

/* ─── Command Palette ────────────────────────────────────── */

#palette-container {
    border: solid $border;
    background: $surface-alt;
    padding: 1 2;
    width: 52;
    max-height: 20;
}

#palette-input {
    border-bottom: solid $border;
    background: transparent;
    margin-bottom: 1;
    width: 100%;
    color: $text;
    padding: 0;
    height: 1;
}

#palette-input:focus {
    border-bottom: solid $border-focus;
}

#palette-list {
    height: auto;
    max-height: 14;
    background: transparent;
}

.palette-item {
    padding: 0 1;
}

.palette-name {
    color: $text;
    text-style: bold;
}

.palette-desc {
    color: $text-muted;
}

/* ─── Input Fields (Global) ──────────────────────────────── */

Input {
    background: transparent;
    color: $text;
    border: none;
    border-bottom: solid $border;
    padding: 0;
}

Input:focus {
    border: none;
    border-bottom: solid $border-focus;
}

/* ─── Scrollbars ─────────────────────────────────────────── */

ScrollableContainer {
    scrollbar-color: $border;
    scrollbar-color-active: $accent;
    scrollbar-background: transparent;
}

/* ─── Notifications / Toasts ─────────────────────────────── */

Toast {
    background: $surface-alt;
    border: solid $border;
    color: $text;
}

Toast.-information {
    border-left: thick $accent;
}

Toast.-warning {
    border-left: thick $warning;
}

Toast.-error {
    border-left: thick $error;
}

/* ─── Empty States ───────────────────────────────────────── */

.empty-state {
    color: $text-dim;
    text-align: center;
    padding: 2 4;
}

/* ─── Error States ───────────────────────────────────────── */

.error-state {
    color: $error;
    padding: 1 0;
}

/* ─── Skeleton Loading ───────────────────────────────────── */

.skeleton {
    background: $surface;
    color: $border;
}

/* ─── Responsive Behavior ────────────────────────────────── */

.-narrow #sidebar {
    display: none;
}

.-narrow #evidence-panel {
    display: none;
}

.-narrow #home-input-zone {
    width: 95%;
}

.-narrow #home-recent-list {
    width: 95%;
}

.-narrow #analysis-progress-bar {
    width: 90%;
}

.-narrow #analysis-pipeline-stages {
    width: 90%;
}

.-narrow #analysis-log-container {
    width: 90%;
}
